{
  "$comment": "Paste into the Parse JSON action that follows the AI classification step in ClassifyAndDraft.",
  "type": "object",
  "properties": {
    "isITRequest": { "type": "boolean" },
    "notARequestReason": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["ACCOUNT", "CONNECTIVITY", "SECURITY", "HARDWARE", "SOFTWARE", "JML"]
    },
    "urgency": { "type": "string", "enum": ["P1", "P2", "P3"] },
    "urgencyReason": { "type": "string" },
    "subject": { "type": "string" },
    "summary": { "type": "string" },
    "missingInfo": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  },
  "required": ["isITRequest", "category", "urgency", "subject", "summary", "confidence"]
}
