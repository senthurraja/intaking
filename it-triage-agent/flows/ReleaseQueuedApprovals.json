{
  "$comment": "Power Automate flow definition — scheduled flow. Runs hourly (Q06). Wakes up, and if it is a working morning, releases everything that was queued overnight by calling RequestApproval for each. Outside the release window it does nothing and costs one trivial run.",
  "properties": {
    "displayName": "IT Triage — Release Queued Approvals",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "Every_hour": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1,
            "timeZone": "GMT Standard Time",
            "schedule": { "minutes": [5] }
          }
        }
      },
      "actions": {
        "Only_on_a_working_morning": {
          "$comment": "09:00–10:00 Mon–Fri. Everything queued overnight goes out in the 09:05 run; the other 23 runs exit immediately.",
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              { "equals": ["@int(formatDateTime(convertTimeZone(utcNow(),'UTC','GMT Standard Time'),'HH'))", 9] },
              { "greaterOrEquals": ["@dayOfWeek(convertTimeZone(utcNow(),'UTC','GMT Standard Time'))", 1] },
              { "lessOrEquals": ["@dayOfWeek(convertTimeZone(utcNow(),'UTC','GMT Standard Time'))", 5] }
            ]
          },
          "actions": {
            "Get_the_overnight_queue": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                "parameters": {
                  "dataset": "@parameters('SiteUrl')",
                  "table": "@parameters('AuditListName')",
                  "$filter": "Status eq 'Queued — out of hours'",
                  "$orderby": "Urgency asc,Created asc",
                  "$top": 100
                }
              }
            },
            "Release_each_one": {
              "$comment": "Sequential, not parallel — a burst of ten cards at 09:05 is unreadable. One at a time, highest priority first.",
              "runAfter": { "Get_the_overnight_queue": ["Succeeded"] },
              "type": "Foreach",
              "foreach": "@body('Get_the_overnight_queue')?['value']",
              "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
              "actions": {
                "Reset_to_awaiting": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                    "parameters": {
                      "dataset": "@parameters('SiteUrl')",
                      "table": "@parameters('AuditListName')",
                      "id": "@items('Release_each_one')?['ID']",
                      "item/Status": "Awaiting approval"
                    }
                  }
                },
                "Call_RequestApproval": {
                  "runAfter": { "Reset_to_awaiting": ["Succeeded"] },
                  "type": "Workflow",
                  "inputs": {
                    "host": { "workflowReferenceName": "@parameters('RequestApprovalFlowId')" },
                    "body": {
                      "text_TicketRef": "@items('Release_each_one')?['Title']",
                      "text_GapAnswers": ""
                    }
                  }
                }
              }
            }
          },
          "else": { "actions": {} }
        }
      },
      "outputs": {}
    }
  }
}
