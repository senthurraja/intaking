{
  "$comment": "Power Automate flow definition — child flow #2. Decides send-now vs queue-until-morning, posts the Adaptive Card to the approver, then sends the ticket email and closes the loop with the requester.",
  "properties": {
    "displayName": "IT Triage — Request Approval and Send",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text_TicketRef": { "title": "TicketRef", "type": "string" },
                "text_GapAnswers": { "title": "GapAnswers", "type": "string" }
              },
              "required": ["text_TicketRef"]
            }
          }
        }
      },
      "actions": {
        "Get_the_logged_ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
            "parameters": {
              "dataset": "@parameters('SiteUrl')",
              "table": "@parameters('AuditListName')",
              "$filter": "@{concat('Title eq ''', triggerBody()?['text_TicketRef'], '''')}",
              "$top": 1
            }
          }
        },

        "Is_it_inside_working_hours": {
          "$comment": "Q07 — queue overnight, release at 09:00 on working days. P1 still queues; the topic tells the requester to phone the service desk if it cannot wait.",
          "runAfter": { "Get_the_logged_ticket": ["Succeeded"] },
          "type": "If",
          "expression": {
            "and": [
              { "greaterOrEquals": ["@int(formatDateTime(convertTimeZone(utcNow(),'UTC',parameters('TimeZone')),'HH'))", 9] },
              { "less": ["@int(formatDateTime(convertTimeZone(utcNow(),'UTC',parameters('TimeZone')),'HH'))", 17] },
              { "greaterOrEquals": ["@dayOfWeek(convertTimeZone(utcNow(),'UTC',parameters('TimeZone')))", 1] },
              { "lessOrEquals": ["@dayOfWeek(convertTimeZone(utcNow(),'UTC',parameters('TimeZone')))", 5] }
            ]
          },
          "actions": {
            "Post_approval_card": {
              "$comment": "Adaptive card body lives in ../adaptive-cards/approval-card.json. Use 'Post adaptive card and wait for a response' so the flow blocks on the click.",
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_teams", "operationId": "PostAdaptiveCardAndWaitForResponse", "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams" },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@parameters('ApproverEmail')",
                  "body/messageBody": "@{parameters('ApprovalCardJson')}",
                  "body/updateMessage": "Handled — thanks."
                }
              }
            },

            "Approved_or_not": {
              "runAfter": { "Post_approval_card": ["Succeeded"] },
              "type": "Switch",
              "expression": "@body('Post_approval_card')?['submitActionId']",
              "cases": {
                "Send": {
                  "case": "send",
                  "actions": {
                    "Send_the_ticket_email": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": { "connectionName": "shared_office365", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                        "parameters": {
                          "emailMessage/To": "@parameters('ITSupportMailbox')",
                          "emailMessage/Subject": "@{concat('[', body('Get_the_logged_ticket')?['value'][0]?['Urgency'], ' — ', body('Get_the_logged_ticket')?['value'][0]?['Category'], '] ', body('Get_the_logged_ticket')?['value'][0]?['DraftSubject'])}",
                          "emailMessage/Body": "@{parameters('TicketEmailHtml')}",
                          "emailMessage/Importance": "@{if(equals(body('Get_the_logged_ticket')?['value'][0]?['Urgency'],'P1'),'High','Normal')}"
                        }
                      }
                    },
                    "Mark_sent": {
                      "runAfter": { "Send_the_ticket_email": ["Succeeded"] },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                        "parameters": {
                          "dataset": "@parameters('SiteUrl')",
                          "table": "@parameters('AuditListName')",
                          "id": "@body('Get_the_logged_ticket')?['value'][0]?['ID']",
                          "item/Status": "Sent",
                          "item/ApprovedAt": "@{utcNow()}",
                          "item/ApproverComment": "@{body('Post_approval_card')?['data']?['comment']}"
                        }
                      }
                    },
                    "Tell_the_requester": {
                      "$comment": "Q09 — auto-reply after approval, in the same Teams conversation.",
                      "runAfter": { "Mark_sent": ["Succeeded"] },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": { "connectionName": "shared_teams", "operationId": "PostMessageToConversation", "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams" },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "body/recipient": "@{body('Get_the_logged_ticket')?['value'][0]?['RequesterEmail']}",
                          "body/messageBody": "<p>Your request <b>@{triggerBody()?['text_TicketRef']}</b> is now with IT Support. They'll come back to you directly. If anything changes in the meantime, message me and I'll add it.</p>"
                        }
                      }
                    }
                  }
                },
                "Discard": {
                  "case": "discard",
                  "actions": {
                    "Mark_discarded": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                        "parameters": {
                          "dataset": "@parameters('SiteUrl')",
                          "table": "@parameters('AuditListName')",
                          "id": "@body('Get_the_logged_ticket')?['value'][0]?['ID']",
                          "item/Status": "Discarded",
                          "item/ApproverComment": "@{body('Post_approval_card')?['data']?['comment']}"
                        }
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {
                  "Mark_edit_requested": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                      "parameters": {
                        "dataset": "@parameters('SiteUrl')",
                        "table": "@parameters('AuditListName')",
                        "id": "@body('Get_the_logged_ticket')?['value'][0]?['ID']",
                        "item/Status": "Edit requested",
                        "item/DraftSummary": "@{body('Post_approval_card')?['data']?['summary']}",
                        "item/ApproverComment": "@{body('Post_approval_card')?['data']?['comment']}"
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Queue_until_morning": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
                  "parameters": {
                    "dataset": "@parameters('SiteUrl')",
                    "table": "@parameters('AuditListName')",
                    "id": "@body('Get_the_logged_ticket')?['value'][0]?['ID']",
                    "item/Status": "Queued — out of hours"
                  }
                }
              }
            }
          }
        },

        "Respond_to_the_agent": {
          "runAfter": { "Is_it_inside_working_hours": ["Succeeded"] },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "body": { "queued": "@equals(body('Get_the_logged_ticket')?['value'][0]?['Status'], 'Queued — out of hours')" },
            "schema": { "type": "object", "properties": { "queued": { "type": "boolean" } } }
          }
        }
      },
      "outputs": {}
    }
  }
}
